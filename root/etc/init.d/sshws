#!/bin/sh /etc/rc.common

# Menggunakan sistem Procd OpenWrt modern
USE_PROCD=1
START=99
STOP=10

start_service() {
    # 1. Membaca database dari /etc/config/sshws
    config_load sshws

    # 2. Mengambil status 'enabled' (apakah dicentang di GUI?)
    local enabled
    config_get enabled main enabled '0'

    # Jika tidak dicentang (0), batalkan proses start
    if [ "$enabled" -ne 1 ]; then
        return 0
    fi

    # 3. Mengambil sisa variabel dari GUI
    local server_ip port username password sni payload local_socks_port
    config_get server_ip main server_ip
    config_get port main port
    config_get username main username
    config_get password main password
    config_get sni main sni
    config_get payload main payload
    config_get local_socks_port main local_socks_port '1080'

    # Validasi: Jangan jalan jika IP atau Username kosong
    if [ -z "$server_ip" ] || [ -z "$username" ]; then
        echo "SSHWS: Konfigurasi tidak lengkap. Membatalkan start." >&2
        return 1
    fi

    echo "SSHWS: Memulai proses tunnel menuju $server_ip..."

    # 4. Mendaftarkan aplikasi ke sistem background (Procd)
    procd_open_instance "sshws_main"
    
    # Memanggil script 'core routing' dan melempar semua variabel GUI kepadanya
    procd_set_param command /usr/bin/sshws-core.sh
    procd_append_param command "$server_ip" "$port" "$username" "$password" "$sni" "$payload" "$local_socks_port"
    
    # Fitur canggih: Jika koneksi SSH putus, procd akan merestartnya secara otomatis
    procd_set_param respawn
    
    # Menyimpan log error/output ke system log (agar bisa dibaca via 'logread')
    procd_set_param stdout 1
    procd_set_param stderr 1
    
    procd_close_instance
}

# 5. Memicu restart otomatis jika ada perubahan setting dari GUI LuCI
service_triggers() {
    procd_add_reload_trigger "sshws"
}